{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "mutate": [
    "src/**/*.ts",
    "scripts/lib/**/*.ts",
    "!**/*.test.ts",
    "!**/*.spec.ts"
  ],
  "reporters": ["clear-text", "progress", "html"],
  "thresholds": {
    "high": 95,
    "low": 95,
    "break": 95
  },
  "timeoutMS": 10000
}
